rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Inspection reports: Allow read for anyone or signed-in users, allow create if signed in or local session
    match /reports/{reportId} {
      allow read: if true;
      allow create: if request.auth != null || request.resource.data.siteNo is string;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.engineerUid || resource.data.engineerUid == null);
    }

    // Inventory items
    match /inventory/{siteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
